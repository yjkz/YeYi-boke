# MySQL root password (used by both mysql and backend containers)
MYSQL_ROOT_PASSWORD=your_password_here

# JWT secret key for token signing (change to a random string)
JWT_SECRET_KEY=your_random_secret_here

# MCP values are required by deploy/docker-compose.prod.yml in production.
# Store real values in GitHub Actions Secrets; do not commit this file with secrets.
# The bootstrap API Key can be rotated later from the admin MCP management page.
MCP_API_KEY=change-me-mcp-key
MCP_SETTINGS_ENCRYPTION_KEY=2Lgqs7X5oGrSOqBHg7zrkueOGjRreTHlg7u2JA3Y0YM=
MCP_PUBLIC_URL=https://blogmcp.yeyeyiyi.online/mcp
MCP_RATE_LIMIT=120
MCP_RATE_WINDOW=60
# Optional transport checks. Values are JSON arrays, for example ["mcp.yeyeyiyi.online"]
MCP_ALLOWED_HOSTS=["blogmcp.yeyeyiyi.online"]
MCP_ALLOWED_ORIGINS=["https://blogmcp.yeyeyiyi.online"]
